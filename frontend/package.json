{
  "name": "next-frontend",
  "version": "1.0.0",
  "description": "Next JS chat",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @app/web run dev",
    "build": "pnpm --filter @app/web run build",
    "start": "pnpm --filter @app/web run start",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "biome lint .",
    "check": "biome check . && pnpm run typecheck",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
